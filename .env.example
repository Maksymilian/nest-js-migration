# Docker Compose's variables: copy this file to .env (gitignored). The observability profile
# (docs/architecture.md, section 15) and the stripe profile (section 18.6) use them.
# Grafana's admin password, on http://localhost:3000 (user admin).
GRAFANA_ADMIN_PASSWORD=change-me
# The Stripe CLI's key: a test-mode secret key (sk_test_...) of your Stripe sandbox, the same as
# Billing's STRIPE_SECRET_KEY. Never a live key.
STRIPE_SECRET_KEY=
