NODE_ENV=development
PORT=3002
DATABASE_URL=postgres://training_progress:training_progress@localhost:5434/training_progress
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://fitness:fitness@localhost:5672
OUTBOX_RELAY=on
ADMIN_TOKEN=change-me-to-a-long-random-token
# file (development: .eml files in MAIL_DIRECTORY), smtp (needs SMTP_URL) or resend (needs RESEND_API_KEY)
MAIL_TRANSPORT=file
MAIL_DIRECTORY=var/mail
MAIL_FROM=Fitness Platform <progress@fitness.example>
# Telegram bot: off without a token (from @BotFather). polling (development, one instance) or webhook (production)
# TELEGRAM_BOT_TOKEN=
TELEGRAM_UPDATES=polling
# Required with TELEGRAM_UPDATES=webhook: the public URL of POST /telegram/updates, and a secret of 32+ letters, digits, _ or -
# TELEGRAM_WEBHOOK_URL=https://progress.fitness.example/telegram/updates
# TELEGRAM_WEBHOOK_SECRET=
