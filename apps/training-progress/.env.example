NODE_ENV=development
PORT=3002
DATABASE_URL=postgres://training_progress:training_progress@localhost:5434/training_progress
VALKEY_URL=valkey://localhost:6379
# The share of Valkey commands GLIDE traces; 1 to 5 in production
VALKEY_TRACE_SAMPLE_PERCENTAGE=100
RABBITMQ_URL=amqp://fitness:fitness@localhost:5672
OUTBOX_RELAY=on
# The read cache (docs/architecture.md, section 8.1): off reads PostgreSQL every time; with the load
# lock off, every read that misses loads the read model (a cache stampede). Both to compare in load tests.
READ_CACHE=on
READ_CACHE_LOCK=on
# Rate limit and timeouts (docs/architecture.md, section 16): RATE_LIMIT=on limits the requests per
# minute from one caller, per instance (off by default: in AWS, WAF limits callers); and how long a
# query may take before it's cut (GraphQL query fields fail with TIMEOUT)
RATE_LIMIT=off
RATE_LIMIT_PER_MINUTE=600
QUERY_TIMEOUT_MS=3000
# off: logs only go to OpenTelemetry (production), not to the console
LOG_CONSOLE=on
# The web apps that may call GraphQL from a browser (CORS), comma-separated; empty: none
CORS_ORIGINS=
ADMIN_TOKEN=change-me-to-a-long-random-token
# file (development: .eml files in MAIL_DIRECTORY), smtp (needs SMTP_URL) or resend (needs RESEND_API_KEY)
MAIL_TRANSPORT=file
MAIL_DIRECTORY=var/mail
MAIL_FROM=Fitness Platform <progress@fitness.example>
# Telegram bot: off without a token (from @BotFather). polling (development, one instance) or webhook (production)
# TELEGRAM_BOT_TOKEN=
TELEGRAM_UPDATES=polling
# Required with TELEGRAM_UPDATES=webhook: the public URL of POST /telegram/updates, and a secret of 32+ letters, digits, _ or -
# TELEGRAM_WEBHOOK_URL=https://progress.fitness.example/telegram/updates
# TELEGRAM_WEBHOOK_SECRET=
# OpenTelemetry (docs/architecture.md, section 15): traces, metrics and logs over OTLP to Grafana
# Alloy (`docker compose --profile observability`), which requires Basic Auth.
# scripts/observability/telemetry-credentials.sh writes the Authorization header line.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of username:password>
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# OTEL_SDK_DISABLED=true turns telemetry off
