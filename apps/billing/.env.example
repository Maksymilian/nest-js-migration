NODE_ENV=development
PORT=3003
DATABASE_URL=postgres://billing:billing@localhost:5435/billing
RABBITMQ_URL=amqp://fitness:fitness@localhost:5672
OUTBOX_RELAY=on
# Rate limit and timeouts (docs/architecture.md, section 16)
RATE_LIMIT=off
RATE_LIMIT_PER_MINUTE=600
QUERY_TIMEOUT_MS=3000
# off: logs only go to OpenTelemetry (production), not to the console
LOG_CONSOLE=on
ADMIN_TOKEN=change-me-to-a-long-random-token
# The web apps that call the membership routes from a browser, comma-separated
CORS_ORIGINS=
# Stripe's test mode (section 18.6): your sandbox's test secret key (Dashboard > Developers > API
# keys), and the Stripe CLI's signing secret:
#   docker compose --profile stripe run --rm stripe-cli listen --print-secret
# Without the key, checkouts answer 503; without the signing secret, the webhook route is off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Checkout and the Billing Portal send the member back
MEMBERSHIP_PAGE_URL=http://localhost:5173/membership
# OpenTelemetry (docs/architecture.md, section 15): traces, metrics and logs over OTLP to Grafana
# Alloy (`docker compose --profile observability`), which requires Basic Auth.
# scripts/observability/telemetry-credentials.sh writes the Authorization header line.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of username:password>
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# OTEL_SDK_DISABLED=true turns telemetry off
