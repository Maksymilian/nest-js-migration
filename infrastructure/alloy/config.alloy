// Grafana Alloy (docs/architecture.md, section 15): the one collector. It receives the services'
// OpenTelemetry and k6's metrics, scrapes RabbitMQ and Valkey, and collects their containers' logs,
// then sends traces to Tempo, logs to Loki and metrics to Prometheus. Only its OTLP port is published.

// --- The services: OTLP/HTTP on 4318, only with Basic Auth. The credentials are a bcrypt htpasswd
// file, which scripts/observability/telemetry-credentials.sh creates; without it, Alloy doesn't start.

otelcol.auth.basic "services" {
  htpasswd {
    file = "/etc/alloy/htpasswd"
  }
}

otelcol.receiver.otlp "services" {
  http {
    endpoint = "0.0.0.0:4318"
    auth     = otelcol.auth.basic.services.handler
  }
  output {
    metrics = [otelcol.processor.transform.service_labels.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Prometheus keeps resource attributes in target_info; the service, its version and the environment
// become labels of every metric instead, so dashboards and alerts filter on them directly, and the
// old and the new version of a service can be compared during a rolling deploy (service_version).
otelcol.processor.transform "service_labels" {
  error_mode = "ignore"
  metric_statements {
    context    = "datapoint"
    statements = [
      `set(attributes["service.name"], resource.attributes["service.name"])`,
      `set(attributes["service.version"], resource.attributes["service.version"])`,
      `set(attributes["deployment.environment.name"], resource.attributes["deployment.environment.name"])`,
    ]
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.services.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}

// Loki's own OTLP endpoint: service.name becomes the service_name label, the trace and span ids and
// the flow id (session_id) structured metadata.
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

otelcol.exporter.prometheus "services" {
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

// --- RabbitMQ: its built-in Prometheus plugin. Per queue (messages, ready, unacknowledged, consumers,
// deliveries and acknowledgements), and the node's aggregated metrics. Every scrape runs at Prometheus'
// scrape_interval (15s), not Alloy's default 60s: the alert rules' [1m] windows need several samples.

prometheus.scrape "rabbitmq_queues" {
  job_name        = "rabbitmq"
  targets         = [{"__address__" = "rabbitmq:15692"}]
  metrics_path    = "/metrics/detailed"
  params          = {"family" = ["queue_coarse_metrics", "queue_consumer_count", "queue_delivery_metrics"]}
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "rabbitmq_node" {
  job_name        = "rabbitmq-node"
  targets         = [{"__address__" = "rabbitmq:15692"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

// --- Valkey: read straight from the server (INFO), by Alloy's embedded Redis exporter (Valkey
// speaks the same protocol and INFO; its metrics keep the exporter's redis_ names).

prometheus.exporter.redis "valkey" {
  redis_addr = "valkey:6379"
}

prometheus.scrape "valkey" {
  job_name        = "valkey"
  targets         = prometheus.exporter.redis.valkey.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

// --- k6's metrics, from the load tests (docs/architecture.md, section 17): Prometheus remote write
// from the k6 container (Compose profile `load-tests`) to http://alloy:9091/api/v1/metrics/write. Only
// on the Compose network, like Prometheus' own receiver: the port isn't published.

prometheus.receive_http "k6" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9091
  }
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// --- RabbitMQ's and Valkey's container logs, labelled with their Compose service.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "infrastructure_logs" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "rabbitmq|valkey"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "infrastructure_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.infrastructure_logs.output
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
