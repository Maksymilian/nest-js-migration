{
  "uid": "fitness-platform",
  "title": "Fitness platform",
  "tags": [
    "fitness-platform"
  ],
  "timezone": "browser",
  "editable": false,
  "description": "Workout Tracking and Training Progress (OpenTelemetry via Alloy), RabbitMQ and Redis (scraped by Alloy), traces in Tempo, logs in Loki, and the alert rules. Provisioned from infrastructure/grafana/dashboards/.",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, deployment_environment_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\"}, service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\"}, service_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "interface",
        "label": "Interface",
        "description": "How the interactions reached the platform: graphql, telegram (the bot), rest, or rabbitmq (a message no interaction started). Filters the traces and logs panels; metrics don't carry it.",
        "type": "custom",
        "query": "graphql,telegram,rest,rabbitmq",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "flow",
        "label": "Flow (session.id)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Alerts",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "alertlist",
      "title": "Fitness platform alert rules",
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "showInstances": true,
        "folder": {
          "title": "Fitness platform"
        },
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": true,
          "error": true
        }
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "text",
      "title": "Traces, logs and flows",
      "options": {
        "mode": "markdown",
        "content": "**A trace** is one roundtrip and what it causes, across both services: a recording runs from Workout Tracking's `POST .../recordings` to Training Progress' policies. Open one from the *Traces* panels, or from a log (its `trace_id`).\n\n**A flow** is a member's interaction over several roundtrips (`baggage: session.id=<flow id>`): type its id in the **flow** box above to see its traces and logs.\n\nDashboards and alert rules are files in `infrastructure/grafana/`."
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "row",
      "id": 4,
      "title": "Services: HTTP (OpenTelemetry)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per minute, by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", service_name=~\"$service\"}[$__rate_interval])) * 60",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "id": 5
    },
