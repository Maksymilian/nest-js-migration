    {
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && (span.interface=~\"$interface\" || \"$interface\"=\".*\")}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "id": 16,
      "description": "The latest traces of the services, in the interface picked above (with All, every trace)."
    },
    {
      "type": "row",
      "id": 17,
      "title": "Flow: the roundtrips of one interaction (type its id in the flow box)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Traces of the flow",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{span.session.id=\"$flow\"}",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "id": 18
    },
    {
      "type": "logs",
      "title": "Logs of the flow",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\"} | session_id=\"$flow\""
        }
      ],
      "options": {
        "showTime": true,
