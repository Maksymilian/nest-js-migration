    {
      "type": "timeseries",
      "title": "Timeouts per minute, by entrypoint",
      "description": "Queries that took longer than QUERY_TIMEOUT_MS: 504 over HTTP, TIMEOUT over GraphQL. Their work goes on in the background, holding a database connection (resilience_events_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
