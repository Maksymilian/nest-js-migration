          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, http_request_method, http_route) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", service_name=~\"$service\"}[$__rate_interval])) * 60",
          "legendFormat": "{{service_name}} {{http_request_method}} {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
