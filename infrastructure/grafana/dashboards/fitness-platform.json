    {
      "type": "timeseries",
      "title": "Rejected and failed responses per minute",
      "description": "What callers saw: HTTP 429 (GraphQL's TOO_MANY_REQUESTS too, on /graphql) and 5xx (504 is a timeout) by route, and GraphQL operations that failed with TIMEOUT or INTERNAL_SERVER_ERROR, which answer 200.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"429|5..\", deployment_environment_name=~\"$env\", service_name=~\"$service\"}[$__rate_interval])) * 60",
          "legendFormat": "{{service_name}} {{http_route}} {{http_response_status_code}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (graphql_root_fields, error_type) (rate(graphql_server_operation_duration_seconds_count{deployment_environment_name=~\"$env\", error_type=~\"TIMEOUT|INTERNAL_SERVER_ERROR\"}[$__rate_interval])) * 60",
          "legendFormat": "GraphQL {{graphql_root_fields}} {{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
