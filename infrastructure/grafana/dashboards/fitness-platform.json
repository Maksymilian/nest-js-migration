      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (service_name, http_request_method, http_route) (increase(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", service_name=~\"$service\"}[1h])))",
          "legendFormat": "{{service_name}} {{http_request_method}} {{http_route}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
