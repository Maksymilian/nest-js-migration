{
  "name": "nest-js-migration",
  "version": "0.0.1",
  "description": "Fitness platform: Workout Tracking and Training Progress, two NestJS microservices designed with DDD",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm check:architecture && nest build workout-tracking && nest build training-progress",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs apps libs",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint --type-aware apps/ libs/ && pnpm check:architecture",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod:workout-tracking": "node dist/apps/workout-tracking/main",
    "start:prod:training-progress": "node dist/apps/training-progress/main",
    "db:generate:workout-tracking": "drizzle-kit generate --config apps/workout-tracking/drizzle.config.ts",
    "db:generate:training-progress": "drizzle-kit generate --config apps/training-progress/drizzle.config.ts",
    "db:migrate:workout-tracking": "drizzle-kit migrate --config apps/workout-tracking/drizzle.config.ts",
    "db:migrate:training-progress": "drizzle-kit migrate --config apps/training-progress/drizzle.config.ts",
    "db:migrate": "pnpm db:migrate:workout-tracking && pnpm db:migrate:training-progress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@date-fns/utc": "^2.1.1",
    "@keyv/redis": "^6.1.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/mail": "^0.0.1",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/outbox": "^0.1.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "graphql": "^16.14.2",
    "keyv": "^6.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.8",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.5.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
