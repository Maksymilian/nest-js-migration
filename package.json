{
  "name": "nest-js-migration",
  "version": "0.0.1",
  "description": "Fitness platform: Workout Tracking and Training Progress, two NestJS microservices designed with DDD",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm check:architecture && nest build workout-tracking && nest build training-progress",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs apps libs",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint --type-aware apps/ libs/ && pnpm typecheck && pnpm check:architecture",
    "typecheck": "tsc --noEmit -p libs/ddd/tsconfig.lib.json && tsc --noEmit -p libs/telemetry/tsconfig.lib.json && tsc --noEmit -p libs/workout-tracking-contracts/tsconfig.lib.json && tsc --noEmit -p apps/workout-tracking/tsconfig.app.json && tsc --noEmit -p apps/training-progress/tsconfig.app.json && tsc --noEmit -p load-tests/tsconfig.json",
    "start:dev": "nest start --watch",
    "start:dev:workout-tracking": "nest start workout-tracking --watch --env-file apps/workout-tracking/.env --exec \"node --import ./dist/apps/workout-tracking/instrumentation.js\"",
    "start:dev:training-progress": "nest start training-progress --watch --env-file apps/training-progress/.env --exec \"node --import ./dist/apps/training-progress/instrumentation.js\"",
    "start:debug": "nest start --debug --watch",
    "start:prod:workout-tracking": "node --env-file-if-exists=apps/workout-tracking/.env --import ./dist/apps/workout-tracking/instrumentation.js dist/apps/workout-tracking/main.js",
    "start:prod:training-progress": "node --env-file-if-exists=apps/training-progress/.env --import ./dist/apps/training-progress/instrumentation.js dist/apps/training-progress/main.js",
    "db:generate:workout-tracking": "drizzle-kit generate --config apps/workout-tracking/drizzle.config.ts",
    "db:generate:training-progress": "drizzle-kit generate --config apps/training-progress/drizzle.config.ts",
    "db:migrate:workout-tracking": "drizzle-kit migrate --config apps/workout-tracking/drizzle.config.ts",
    "db:migrate:training-progress": "drizzle-kit migrate --config apps/training-progress/drizzle.config.ts",
    "db:migrate": "pnpm db:migrate:workout-tracking && pnpm db:migrate:training-progress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@date-fns/utc": "^2.1.1",
    "@keyv/redis": "^6.1.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/locks": "0.0.3",
    "@nestjs/mail": "^0.0.1",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/outbox": "^0.1.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/resilience": "^0.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/webhooks": "^0.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/baggage-log-record-processor": "^0.24.0",
    "@opentelemetry/baggage-span-processor": "^0.5.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@redis/client": "6.3.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudevents": "^10.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "grammy": "^1.46.0",
    "graphql": "^16.14.2",
    "keyv": "^6.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@rspack/core": "^2.2.8",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/k6": "~2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.5.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
