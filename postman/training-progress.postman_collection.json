            "url": {
              "raw": "{{trainingProgressUrl}}/graphql",
              "host": [
                "{{trainingProgressUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        }
      ],
      "description": "Queries: read models, cached in Redis where useful."
