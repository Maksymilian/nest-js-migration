            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query TrainingGoals($id: ID!) {\n  member(id: $id) {\n    trainingGoals { id metric target discipline startsOn endsOn status progress achievedAt }\n  }\n}\n",
                "variables": "{\n  \"id\": \"{{memberId}}\"\n}"
