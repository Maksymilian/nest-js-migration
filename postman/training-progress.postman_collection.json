{
  "info": {
    "_postman_id": "0199c3a2-0000-7000-8000-00000000c002",
    "name": "Training Progress (GraphQL)",
    "description": "Training Progress' external GraphQL API at /graphql: a member's training log, progress summaries, streak, personal records and training goals.\n\nUntil Identity exists, a member is chosen with `member(id:)`, and the id is their email address. Liquibase seeds two active goals: Ada cycles 200 km in October 2026, Grace does 12 workouts by the end of 2026. Record workouts with the Workout Tracking (REST) collection first: they arrive here through RabbitMQ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "trainingProgressUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "memberId",
      "value": "ada@example.com"
    },
    {
      "key": "adaGoalId",
      "value": "0199c3a2-0000-7000-8000-000000000201"
    },
    {
      "key": "adminToken",
      "value": "change-me-to-a-long-random-token"
    },
    {
      "key": "trainingGoalId",
      "value": ""
    },
    {
      "key": "endCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Member",
      "item": [
        {
          "name": "Member's progress at a glance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('has no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query MemberProgress($id: ID!) {\n  member(id: $id) {\n    id\n    streak\n    thisWeek: progressSummary(period: WEEK) { periodStart periodEnd workoutCount totalDistanceMeters totalDurationSeconds totalCalories }\n    personalRecords { discipline metric value setAt loggedWorkout { id startedAt } }\n    trainingGoals(status: ACTIVE) { id metric target discipline startsOn endsOn status progress }\n  }\n}\n",
                "variables": "{\n  \"id\": \"{{memberId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{trainingProgressUrl}}/graphql",
              "host": [
                "{{trainingProgressUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        },
        {
          "name": "Training log (first page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('has no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "pm.collectionVariables.set('endCursor', pm.response.json().data.member.trainingLog.pageInfo.endCursor || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query TrainingLog($id: ID!, $first: Int) {\n  member(id: $id) {\n    trainingLog(first: $first) {\n      edges { cursor node { id discipline startedAt durationSeconds distanceMeters calories } }\n      pageInfo { hasNextPage endCursor }\n    }\n  }\n}\n",
                "variables": "{\n  \"id\": \"{{memberId}}\",\n  \"first\": 2\n}"
              }
            },
            "url": {
              "raw": "{{trainingProgressUrl}}/graphql",
              "host": [
                "{{trainingProgressUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Counting workouts only, newest first. Pass `pageInfo.endCursor` as `after` for the next page."
          }
        },
        {
          "name": "Training log (next page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query TrainingLogNextPage($id: ID!, $after: String) {\n  member(id: $id) {\n    trainingLog(first: 2, after: $after) {\n      edges { node { id startedAt distanceMeters } }\n      pageInfo { hasNextPage endCursor }\n    }\n  }\n}\n",
                "variables": "{\n  \"id\": \"{{memberId}}\",\n  \"after\": \"{{endCursor}}\"\n}"
              }
            },
            "url": {
              "raw": "{{trainingProgressUrl}}/graphql",
              "host": [
                "{{trainingProgressUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        },
        {
          "name": "Progress summaries: week, month, year",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('has no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ProgressSummaries($id: ID!, $date: DateTime) {\n  member(id: $id) {\n    week: progressSummary(period: WEEK, date: $date) { periodStart periodEnd workoutCount totalDistanceMeters }\n    month: progressSummary(period: MONTH, date: $date) { periodStart periodEnd workoutCount totalDistanceMeters }\n    cyclingThisYear: progressSummary(period: YEAR, date: $date, discipline: CYCLING) { periodStart periodEnd workoutCount totalDistanceMeters totalCalories }\n  }\n}\n",
                "variables": "{\n  \"id\": \"{{memberId}}\",\n  \"date\": \"2026-10-08T12:00:00Z\"\n}"
              }
            },
            "url": {
              "raw": "{{trainingProgressUrl}}/graphql",
              "host": [
                "{{trainingProgressUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Training periods are ISO weeks, calendar months and years in UTC; `periodEnd` is exclusive."
          }
        },
