                "variables": "{\n  \"input\": {\n    \"memberId\": \"{{memberId}}\",\n    \"metric\": \"WORKOUT_COUNT\",\n    \"target\": 20,\n    \"startsOn\": \"2026-10-01T00:00:00Z\",\n    \"endsOn\": \"2027-01-01T00:00:00Z\"\n  }\n}"
