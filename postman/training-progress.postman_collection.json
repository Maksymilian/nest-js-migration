              "graphql": {
                "query": "query PersonalRecords($id: ID!) {\n  member(id: $id) {\n    personalRecords(discipline: CYCLING) { metric value setAt loggedWorkout { id startedAt distanceMeters durationSeconds calories } }\n  }\n}\n",
                "variables": "{\n  \"id\": \"{{memberId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{trainingProgressUrl}}/graphql",
              "host": [
                "{{trainingProgressUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        },
        {
          "name": "Training goals with progress",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('has no errors', () => pm.expect(pm.response.json().errors).to.be.undefined);"
