                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('is voided and kept', () => pm.expect(pm.response.json().status).to.eql('VOIDED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{workoutTrackingUrl}}/internal/v1/workouts/{{workoutId}}/void",
              "host": [
                "{{workoutTrackingUrl}}"
