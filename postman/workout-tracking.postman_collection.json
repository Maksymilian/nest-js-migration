              "path": [
                "internal",
                "v1",
                "workouts",
                "{{workoutId}}",
                "void"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Someone else rode the bike\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A voided workout is kept, never deleted, and final. Training Progress stops counting it."
          }
